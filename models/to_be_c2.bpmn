        <dc:Bounds x="2190" y="655" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_RetestJoin_di" bpmnElement="Gateway_RetestJoin" isMarkerVisible="true">
        <dc:Bounds x="2335" y="670" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_TestSplit_di" bpmnElement="Gateway_TestSplit" isMarkerVisible="true">
        <dc:Bounds x="2435" y="670" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_FixDefects_di" bpmnElement="Task_FixDefects">
        <dc:Bounds x="2410" y="415" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RetestFixedDefects_di" bpmnElement="Task_RetestFixedDefects">
        <dc:Bounds x="2310" y="545" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ApproveRelease_di" bpmnElement="Task_ApproveRelease">
        <dc:Bounds x="2530" y="265" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ReleaseSplit_di" bpmnElement="Gateway_ReleaseSplit" isMarkerVisible="true">
        <dc:Bounds x="2675" y="280" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RefineApplication_di" bpmnElement="Task_RefineApplication">
        <dc:Bounds x="2650" y="415" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DeployApplication_di" bpmnElement="Task_DeployApplication">
        <dc:Bounds x="2770" y="815" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_StartOperation_di" bpmnElement="Task_StartOperation">
        <dc:Bounds x="2900" y="815" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_MonitorOperation_di" bpmnElement="Task_MonitorOperation">
        <dc:Bounds x="3030" y="815" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EvaluateProject_di" bpmnElement="Task_EvaluateProject">
        <dc:Bounds x="3160" y="815" width="100" height="80" />
