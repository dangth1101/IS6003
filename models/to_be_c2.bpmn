<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ToBe_C2" targetNamespace="https://example.org/is6003/models">
  <bpmn:collaboration id="Collaboration_ToBe_C2">
    <bpmn:participant id="Participant_Bank" name="Bank" processRef="Process_AppDevelopment_ToBe_C2" />
  </bpmn:collaboration>
  <bpmn:process id="Process_AppDevelopment_ToBe_C2" name="Develop application (to-be, retest only)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ToBe_C2">
      <bpmn:lane id="Lane_BusinessUnit" name="Business unit / PMO">
        <bpmn:flowNodeRef>Start_RequestReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HoldKickOff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SpecifyRequirements</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ITManagement" name="IT management">
        <bpmn:flowNodeRef>Gateway_ProposalJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApproveProposal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ProposalSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ProposalRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApprovePlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PlanSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApproveRelease</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReleaseSplit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Development" name="Application development">
        <bpmn:flowNodeRef>Gateway_PlanJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DraftPlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuildApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixDefects</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RefineApplication</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QualityControl" name="QC / Acceptance unit">
        <bpmn:flowNodeRef>Gateway_ReleaseJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewSourceCode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RunFunctionalTests</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RunSecurityTests</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RunAcceptanceTests</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RetestJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TestSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RetestFixedDefects</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ITOperations" name="IT operations / App support / PMO">
        <bpmn:flowNodeRef>Task_ReviseProposal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeployApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StartOperation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MonitorOperation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateProject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ProjectClosed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_RequestReceived" name="Development request received">
      <bpmn:outgoing>Flow_RequestReceived</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_RegisterRequest" name="Register development request">
      <bpmn:incoming>Flow_RequestReceived</bpmn:incoming>
      <bpmn:outgoing>Flow_RequestRegistered</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_ProposalJoin">
      <bpmn:incoming>Flow_RequestRegistered</bpmn:incoming>
      <bpmn:incoming>Flow_ProposalRevised</bpmn:incoming>
      <bpmn:outgoing>Flow_ProposalSubmitted</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ApproveProposal" name="Approve project proposal">
      <bpmn:incoming>Flow_ProposalSubmitted</bpmn:incoming>
      <bpmn:outgoing>Flow_ProposalDecided</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_ProposalSplit">
      <bpmn:incoming>Flow_ProposalDecided</bpmn:incoming>
      <bpmn:outgoing>Flow_ProposalApproved</bpmn:outgoing>
      <bpmn:outgoing>Flow_ProposalChangesRequested</bpmn:outgoing>
      <bpmn:outgoing>Flow_ProposalRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ReviseProposal" name="Revise project proposal">
      <bpmn:incoming>Flow_ProposalChangesRequested</bpmn:incoming>
      <bpmn:outgoing>Flow_ProposalRevised</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_ProposalRejected" name="Proposal rejected">
      <bpmn:incoming>Flow_ProposalRejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_HoldKickOff" name="Hold project kick-off">
      <bpmn:incoming>Flow_ProposalApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_KickOffHeld</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SpecifyRequirements" name="Specify business and technical requirements">
      <bpmn:incoming>Flow_KickOffHeld</bpmn:incoming>
      <bpmn:outgoing>Flow_RequirementsSpecified</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_PlanJoin">
      <bpmn:incoming>Flow_RequirementsSpecified</bpmn:incoming>
      <bpmn:incoming>Flow_PlanChangesRequested</bpmn:incoming>
      <bpmn:outgoing>Flow_PlanStarted</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_DraftPlan" name="Draft detailed project plan">
      <bpmn:incoming>Flow_PlanStarted</bpmn:incoming>
      <bpmn:outgoing>Flow_PlanDrafted</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ApprovePlan" name="Approve project plan">
      <bpmn:incoming>Flow_PlanDrafted</bpmn:incoming>
      <bpmn:outgoing>Flow_PlanDecided</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_PlanSplit">
      <bpmn:incoming>Flow_PlanDecided</bpmn:incoming>
      <bpmn:outgoing>Flow_PlanApproved</bpmn:outgoing>
      <bpmn:outgoing>Flow_PlanChangesRequested</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_BuildApplication" name="Build application">
      <bpmn:incoming>Flow_PlanApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_ApplicationBuilt</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_ReleaseJoin">
      <bpmn:incoming>Flow_ApplicationBuilt</bpmn:incoming>
      <bpmn:incoming>Flow_ApplicationRefined</bpmn:incoming>
      <bpmn:outgoing>Flow_ReleaseCandidateReady</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ReviewSourceCode" name="Review source code">
      <bpmn:incoming>Flow_ReleaseCandidateReady</bpmn:incoming>
      <bpmn:outgoing>Flow_CodeReviewed</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_RunFunctionalTests" name="Run functional tests">
      <bpmn:incoming>Flow_CodeReviewed</bpmn:incoming>
      <bpmn:outgoing>Flow_FunctionsTested</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_RunSecurityTests" name="Run security tests">
      <bpmn:incoming>Flow_FunctionsTested</bpmn:incoming>
      <bpmn:outgoing>Flow_SecurityTested</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_RunAcceptanceTests" name="Run acceptance tests">
      <bpmn:incoming>Flow_SecurityTested</bpmn:incoming>
      <bpmn:outgoing>Flow_AcceptanceTested</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_RetestJoin">
      <bpmn:incoming>Flow_AcceptanceTested</bpmn:incoming>
      <bpmn:incoming>Flow_DefectsRetested</bpmn:incoming>
      <bpmn:outgoing>Flow_TestRoundCompleted</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_TestSplit">
      <bpmn:incoming>Flow_TestRoundCompleted</bpmn:incoming>
      <bpmn:outgoing>Flow_TestsPassed</bpmn:outgoing>
      <bpmn:outgoing>Flow_DefectsFound</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_FixDefects" name="Fix defects">
      <bpmn:incoming>Flow_DefectsFound</bpmn:incoming>
      <bpmn:outgoing>Flow_DefectsFixed</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_RetestFixedDefects" name="Retest fixed defects">
      <bpmn:incoming>Flow_DefectsFixed</bpmn:incoming>
      <bpmn:outgoing>Flow_DefectsRetested</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ApproveRelease" name="Approve application release">
      <bpmn:incoming>Flow_TestsPassed</bpmn:incoming>
      <bpmn:outgoing>Flow_ReleaseDecided</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_ReleaseSplit">
      <bpmn:incoming>Flow_ReleaseDecided</bpmn:incoming>
      <bpmn:outgoing>Flow_ReleaseApproved</bpmn:outgoing>
      <bpmn:outgoing>Flow_ReleaseRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_RefineApplication" name="Refine application">
      <bpmn:incoming>Flow_ReleaseRejected</bpmn:incoming>
      <bpmn:outgoing>Flow_ApplicationRefined</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DeployApplication" name="Deploy application to production">
      <bpmn:incoming>Flow_ReleaseApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_ApplicationDeployed</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_StartOperation" name="Start live operation">
      <bpmn:incoming>Flow_ApplicationDeployed</bpmn:incoming>
      <bpmn:outgoing>Flow_OperationStarted</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_MonitorOperation" name="Monitor live operation">
      <bpmn:incoming>Flow_OperationStarted</bpmn:incoming>
      <bpmn:outgoing>Flow_OperationMonitored</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_EvaluateProject" name="Evaluate project results">
      <bpmn:incoming>Flow_OperationMonitored</bpmn:incoming>
      <bpmn:outgoing>Flow_ProjectEvaluated</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_ProjectClosed" name="Project closed">
      <bpmn:incoming>Flow_ProjectEvaluated</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_RequestReceived" sourceRef="Start_RequestReceived" targetRef="Task_RegisterRequest" />
    <bpmn:sequenceFlow id="Flow_RequestRegistered" sourceRef="Task_RegisterRequest" targetRef="Gateway_ProposalJoin" />
    <bpmn:sequenceFlow id="Flow_ProposalSubmitted" sourceRef="Gateway_ProposalJoin" targetRef="Task_ApproveProposal" />
    <bpmn:sequenceFlow id="Flow_ProposalDecided" sourceRef="Task_ApproveProposal" targetRef="Gateway_ProposalSplit" />
    <bpmn:sequenceFlow id="Flow_ProposalApproved" name="proposal approved" sourceRef="Gateway_ProposalSplit" targetRef="Task_HoldKickOff" />
    <bpmn:sequenceFlow id="Flow_ProposalChangesRequested" name="changes requested" sourceRef="Gateway_ProposalSplit" targetRef="Task_ReviseProposal" />
    <bpmn:sequenceFlow id="Flow_ProposalRejected" name="proposal rejected" sourceRef="Gateway_ProposalSplit" targetRef="End_ProposalRejected" />
    <bpmn:sequenceFlow id="Flow_ProposalRevised" sourceRef="Task_ReviseProposal" targetRef="Gateway_ProposalJoin" />
    <bpmn:sequenceFlow id="Flow_KickOffHeld" sourceRef="Task_HoldKickOff" targetRef="Task_SpecifyRequirements" />
    <bpmn:sequenceFlow id="Flow_RequirementsSpecified" sourceRef="Task_SpecifyRequirements" targetRef="Gateway_PlanJoin" />
    <bpmn:sequenceFlow id="Flow_PlanStarted" sourceRef="Gateway_PlanJoin" targetRef="Task_DraftPlan" />
    <bpmn:sequenceFlow id="Flow_PlanDrafted" sourceRef="Task_DraftPlan" targetRef="Task_ApprovePlan" />
    <bpmn:sequenceFlow id="Flow_PlanDecided" sourceRef="Task_ApprovePlan" targetRef="Gateway_PlanSplit" />
    <bpmn:sequenceFlow id="Flow_PlanApproved" name="plan approved" sourceRef="Gateway_PlanSplit" targetRef="Task_BuildApplication" />
    <bpmn:sequenceFlow id="Flow_PlanChangesRequested" name="plan needs changes" sourceRef="Gateway_PlanSplit" targetRef="Gateway_PlanJoin" />
    <bpmn:sequenceFlow id="Flow_ApplicationBuilt" sourceRef="Task_BuildApplication" targetRef="Gateway_ReleaseJoin" />
    <bpmn:sequenceFlow id="Flow_ReleaseCandidateReady" sourceRef="Gateway_ReleaseJoin" targetRef="Task_ReviewSourceCode" />
    <bpmn:sequenceFlow id="Flow_CodeReviewed" sourceRef="Task_ReviewSourceCode" targetRef="Task_RunFunctionalTests" />
    <bpmn:sequenceFlow id="Flow_FunctionsTested" sourceRef="Task_RunFunctionalTests" targetRef="Task_RunSecurityTests" />
    <bpmn:sequenceFlow id="Flow_SecurityTested" sourceRef="Task_RunSecurityTests" targetRef="Task_RunAcceptanceTests" />
    <bpmn:sequenceFlow id="Flow_AcceptanceTested" sourceRef="Task_RunAcceptanceTests" targetRef="Gateway_RetestJoin" />
    <bpmn:sequenceFlow id="Flow_TestRoundCompleted" sourceRef="Gateway_RetestJoin" targetRef="Gateway_TestSplit" />
    <bpmn:sequenceFlow id="Flow_TestsPassed" name="all tests passed" sourceRef="Gateway_TestSplit" targetRef="Task_ApproveRelease" />
    <bpmn:sequenceFlow id="Flow_DefectsFound" name="defects found" sourceRef="Gateway_TestSplit" targetRef="Task_FixDefects" />
    <bpmn:sequenceFlow id="Flow_DefectsFixed" sourceRef="Task_FixDefects" targetRef="Task_RetestFixedDefects" />
    <bpmn:sequenceFlow id="Flow_DefectsRetested" sourceRef="Task_RetestFixedDefects" targetRef="Gateway_RetestJoin" />
    <bpmn:sequenceFlow id="Flow_ReleaseDecided" sourceRef="Task_ApproveRelease" targetRef="Gateway_ReleaseSplit" />
    <bpmn:sequenceFlow id="Flow_ReleaseApproved" name="release approved" sourceRef="Gateway_ReleaseSplit" targetRef="Task_DeployApplication" />
    <bpmn:sequenceFlow id="Flow_ReleaseRejected" name="release rejected" sourceRef="Gateway_ReleaseSplit" targetRef="Task_RefineApplication" />
    <bpmn:sequenceFlow id="Flow_ApplicationRefined" sourceRef="Task_RefineApplication" targetRef="Gateway_ReleaseJoin" />
    <bpmn:sequenceFlow id="Flow_ApplicationDeployed" sourceRef="Task_DeployApplication" targetRef="Task_StartOperation" />
    <bpmn:sequenceFlow id="Flow_OperationStarted" sourceRef="Task_StartOperation" targetRef="Task_MonitorOperation" />
    <bpmn:sequenceFlow id="Flow_OperationMonitored" sourceRef="Task_MonitorOperation" targetRef="Task_EvaluateProject" />
    <bpmn:sequenceFlow id="Flow_ProjectEvaluated" sourceRef="Task_EvaluateProject" targetRef="End_ProjectClosed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_ToBe_C2">
    <bpmndi:BPMNPlane id="Plane_ToBe_C2" bpmnElement="Collaboration_ToBe_C2">
