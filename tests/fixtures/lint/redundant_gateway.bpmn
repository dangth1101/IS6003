  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="App development" processRef="Process_Redundant" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Redundant" isExecutable="false">
    <bpmn:startEvent id="Start_RequestReceived" name="Request received" />
    <bpmn:task id="Task_WriteSpec" name="Write specification" />
    <bpmn:exclusiveGateway id="Gateway_PassThrough" />
    <bpmn:task id="Task_BuildApp" name="Build application" />
