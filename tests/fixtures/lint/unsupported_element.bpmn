<?xml version="1.0" encoding="UTF-8"?>
<!-- Lint fixture: breaks only SUBSET. A timer intermediate event and a sub-process. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Subset" targetNamespace="https://example.org/is6003/fixtures">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="App development" processRef="Process_Subset" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Subset" isExecutable="false">
    <bpmn:startEvent id="Start_RequestReceived" name="Request received" />
    <bpmn:intermediateCatchEvent id="Timer_OneDayPassed" name="One day passed">
      <bpmn:timerEventDefinition id="TimerDefinition_1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:subProcess id="SubProcess_BuildApp" name="Build application" />
    <bpmn:endEvent id="End_AppReleased" name="Application released" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_RequestReceived" targetRef="Timer_OneDayPassed" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Timer_OneDayPassed" targetRef="SubProcess_BuildApp" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="SubProcess_BuildApp" targetRef="End_AppReleased" />
  </bpmn:process>
</bpmn:definitions>
