<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Sequence" targetNamespace="https://example.org/is6003/fixtures">
  <bpmn:collaboration id="Collaboration_Sequence">
    <bpmn:participant id="Participant_Sequence" name="App development" processRef="Process_Sequence" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Sequence" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Sequence">
      <bpmn:lane id="Lane_Dev" name="Development team">
        <bpmn:flowNodeRef>Start_RequestReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WriteSpec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuildApp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TestApp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_AppReleased</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_RequestReceived" name="Request received">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_WriteSpec" name="Write specification">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_BuildApp" name="Build application">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_TestApp" name="Test application">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_AppReleased" name="Application released">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_RequestReceived" targetRef="Task_WriteSpec" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_WriteSpec" targetRef="Task_BuildApp" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_BuildApp" targetRef="Task_TestApp" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_TestApp" targetRef="End_AppReleased" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Sequence">
    <bpmndi:BPMNPlane id="Plane_Sequence" bpmnElement="Collaboration_Sequence">
      <bpmndi:BPMNShape id="Participant_Sequence_di" bpmnElement="Participant_Sequence" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="700" height="200" />
