        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_WriteSpec_di" bpmnElement="Task_WriteSpec">
        <dc:Bounds x="320" y="140" width="100" height="80" />
