  "changes": [
    {
      "id": "C1",
      "title": "Run security testing next to functional testing",
      "driver": "Testing has the longest wait, and complex apps fail it most often.",
      "heuristic": {
        "name": "Parallelism",
        "ref": "Appendix A"
      },
      "expected_effect": "Testing takes as long as its longest part, not the sum of all parts.",
      "trade_off": {
        "time": "better",
        "cost": "worse",
        "quality": "neutral",
        "flexibility": "neutral",
        "note": "Needs a second tester during the test phase."
      }
    },
    {
      "id": "C2",
      "title": "Fast-track approval for small, low-risk requests",
      "driver": "Approvals wait about two weeks in total, even for small changes.",
      "heuristic": {
        "name": "Triage",
        "ref": "Appendix A"
      },
      "expected_effect": "Small requests skip the full approval meeting.",
      "trade_off": {
        "time": "better",
        "cost": "better",
        "quality": "worse",
        "flexibility": "neutral",
        "note": "Some risky requests may be misjudged as small."
      }
    },
