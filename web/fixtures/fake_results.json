  "threats": [
    {
      "title": "The data is synthetic",
      "detail": "The event log comes from our own simulator, so the models partly find effects we put in ourselves."
    },
    {
      "title": "Parameters are estimates",
      "detail": "Durations, probabilities and capacities are expert guesses, not measurements."
    },
    {
      "title": "No working calendar",
      "detail": "Time runs on a continuous clock with no weekends, holidays or working hours."
    },
    {
      "title": "Identical resources",
      "detail": "Everyone in a lane is treated as equally fast and always available."
    }
