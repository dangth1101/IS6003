    <bpmn:sequenceFlow id="Flow_15" name="accepted" sourceRef="g3" targetRef="appapprove" />
    <bpmn:sequenceFlow id="Flow_16" name="defects found" sourceRef="g3" targetRef="fix" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="fix" targetRef="test" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="appapprove" targetRef="g4" />
    <bpmn:sequenceFlow id="Flow_19" name="approved" sourceRef="g4" targetRef="deploy" />
    <bpmn:sequenceFlow id="Flow_20" name="not approved" sourceRef="g4" targetRef="fix" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="deploy" targetRef="operate" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="operate" targetRef="monitor" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="monitor" targetRef="review" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="review" targetRef="end" />
  </bpmn:process>
