<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_AsIs" targetNamespace="https://example.org/bpm" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.1">
  <bpmn:process id="Process_AppDev_ASIS" name="App development (fake as-is, English copy of current_process.bpmn)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="lane_ops" name="IT operations">
        <bpmn:flowNodeRef>revise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deploy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>operate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>monitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_qa" name="QA and acceptance">
        <bpmn:flowNodeRef>test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_dev" name="Development">
        <bpmn:flowNodeRef>plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_ld" name="IT management">
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>planapprove</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>appapprove</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_bu" name="Business unit">
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>kick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>spec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Development request received" />
    <bpmn:task id="request" name="Register request" />
    <bpmn:task id="approve" name="Approve project" />
    <bpmn:exclusiveGateway id="g1" name="Project approved?" />
    <bpmn:task id="revise" name="Revise proposal" />
    <bpmn:task id="kick" name="Hold kick-off meeting" />
    <bpmn:task id="spec" name="Specify requirements" />
    <bpmn:task id="plan" name="Draft project plan" />
    <bpmn:task id="planapprove" name="Approve plan" />
    <bpmn:exclusiveGateway id="g2" name="Plan approved?" />
    <bpmn:task id="build" name="Build application" />
    <bpmn:task id="test" name="Review, test and accept application" />
    <bpmn:exclusiveGateway id="g3" name="Application accepted?" />
    <bpmn:task id="fix" name="Fix defects" />
    <bpmn:task id="appapprove" name="Approve application" />
    <bpmn:exclusiveGateway id="g4" name="Application approved?" />
    <bpmn:task id="deploy" name="Deploy to live" />
    <bpmn:task id="operate" name="Start live operation" />
    <bpmn:task id="monitor" name="Monitor operation" />
    <bpmn:task id="review" name="Archive records and review results" />
    <bpmn:endEvent id="end" name="Application in operation" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="start" targetRef="request" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="request" targetRef="approve" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="approve" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_4" name="approved" sourceRef="g1" targetRef="kick" />
    <bpmn:sequenceFlow id="Flow_5" name="not approved" sourceRef="g1" targetRef="revise" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="revise" targetRef="approve" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="kick" targetRef="spec" />
